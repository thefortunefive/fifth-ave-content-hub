# 5th Ave Content Hub - Environment Variables
# Copy this file to .dev.vars (for local wrangler dev) or .env (for Node.js standalone)
# NEVER commit real secrets to git.

# NocoDB API Token (required)
NOCODB_TOKEN=your_nocodb_token_here

# NocoDB Base URL (optional — defaults to proxy worker)
# NOCODB_BASE_URL=https://nocodb-proxy.fifthaveai.workers.dev

# OpenAI API Key (required for prompt generation and content enrichment)
OPENAI_API_KEY=your_openai_api_key_here

# Perplexity API Key (optional — used by n8n workflows)
# PERPLEXITY_API_KEY=your_perplexity_api_key_here

# KIE AI API Key (required for image generation — Nano Banana, Ideogram)
KIEAI_API_KEY=your_kieai_api_key_here

# Fal AI API Key (optional fallback for image generation — Flux dev)
# FAL_API_KEY=your_fal_api_key_here

# Blotato API Key (required for social media publishing)
BLOTATO_API_KEY=your_blotato_api_key_here
